# Local development only. Never commit a real .env file.
DATA_GOV_SG_API_KEY=

# OneMap: local mode may use the short-lived token from scripts/onemap_login.py.
ONEMAP_ACCESS_TOKEN=
ONEMAP_TOKEN_EXPIRES_AT=
# Shared deployment: set these as server-side secrets so the token can refresh in memory.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Gemini: server-side only.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Optional team-only shared deployment gate. Leave blank for local development.
PLAYMAP_ACCESS_CODE=
PLAYMAP_SESSION_SECRET=
PLAYMAP_MAX_LLM_CONCURRENCY=2
# Seconds between provider calls (project guard, not a measured quota). Blank uses 2.0.
PLAYMAP_LLM_MIN_INTERVAL_S=2.0
